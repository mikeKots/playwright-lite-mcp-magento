{
  "name": "playwright-lite-mcp",
  "version": "0.1.0",
  "description": "Token-efficient MCP server for Magento / Adobe Commerce QA: health, cache, GraphQL and checkout checks in one call each, plus Playwright code mode",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "magento",
    "adobe-commerce",
    "mage-os",
    "hyva",
    "qa",
    "claude-code"
  ],
  "license": "MIT",
  "author": "Mykhailo Kots",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeKots/playwright-lite-mcp-magento.git"
  },
  "homepage": "https://github.com/mikeKots/playwright-lite-mcp-magento#readme",
  "bugs": "https://github.com/mikeKots/playwright-lite-mcp-magento/issues",
  "type": "module",
  "bin": {
    "playwright-lite-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "browsers": "playwright install chromium",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "playwright": "1.63.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
